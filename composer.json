{
    "name": "milzer/laravel-http-logger",
    "description": "Structured, redacted logging of HTTP traffic in Laravel: incoming requests and outgoing Saloon calls, with one shared trace id.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "http",
        "logging",
        "middleware",
        "saloon",
        "saloon-plugin",
        "request-logging",
        "trace"
    ],
    "homepage": "https://github.com/milzer-tech/laravel-http-logger",
    "support": {
        "issues": "https://github.com/milzer-tech/laravel-http-logger/issues",
        "source": "https://github.com/milzer-tech/laravel-http-logger"
    },
    "authors": [
        {
            "name": "Milzer",
            "email": "azim@milzer.de"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8.2",
        "guzzlehttp/promises": "^2.0",
        "illuminate/console": "^11.0 || ^12.0",
        "illuminate/contracts": "^11.0 || ^12.0",
        "illuminate/filesystem": "^11.0 || ^12.0",
        "illuminate/http": "^11.0 || ^12.0",
        "illuminate/log": "^11.0 || ^12.0",
        "illuminate/routing": "^11.0 || ^12.0",
        "illuminate/support": "^11.0 || ^12.0",
        "league/flysystem": "^3.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.22",
        "orchestra/testbench": "^9.0 || ^10.0",
        "pestphp/pest": "^3.8 || ^4.0",
        "pestphp/pest-plugin-type-coverage": "^3.6.1 || ^4.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-mockery": "^2.0",
        "rector/rector": "^2.1",
        "saloonphp/saloon": "^4.0"
    },
    "suggest": {
        "saloonphp/saloon": "Required to log outgoing calls with the HasLogging Saloon plugin (^4.0)."
    },
    "conflict": {
        "saloonphp/saloon": "<4.0"
    },
    "autoload": {
        "psr-4": {
            "Milzer\\HttpLogger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Milzer\\HttpLogger\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": [
            "pint --parallel",
            "rector"
        ],
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run"
        ],
        "test:unit": "pest --parallel --coverage --exactly=100",
        "test:types": "phpstan",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Milzer\\HttpLogger\\Laravel\\HttpLoggerServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
