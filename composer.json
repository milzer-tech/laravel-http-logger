{
    "name": "milzer/saloon-logger",
    "description": "A Saloon plugin that logs every outgoing request and incoming response as structured, redacted PSR-3 log entries.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "saloon",
        "saloon-plugin",
        "logging",
        "psr-3",
        "http",
        "api",
        "laravel"
    ],
    "homepage": "https://github.com/milzer-tech/saloon-logger",
    "support": {
        "issues": "https://github.com/milzer-tech/saloon-logger/issues",
        "source": "https://github.com/milzer-tech/saloon-logger"
    },
    "authors": [
        {
            "name": "Milzer",
            "email": "azim@milzer.de"
        }
    ],
    "require": {
        "php": "^8.2",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "saloonphp/saloon": "^4.0"
    },
    "require-dev": {
        "laravel/pint": "^1.22",
        "orchestra/testbench": "^9.0 || ^10.0",
        "pestphp/pest": "^3.8 || ^4.0",
        "pestphp/pest-plugin-type-coverage": "^3.6.1 || ^4.0",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.1"
    },
    "suggest": {
        "illuminate/support": "Enables the auto-discovered Laravel service provider and publishable config."
    },
    "autoload": {
        "psr-4": {
            "Milzer\\SaloonLogger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Milzer\\SaloonLogger\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": [
            "pint --parallel",
            "rector"
        ],
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run"
        ],
        "test:unit": "pest --parallel --coverage --exactly=100",
        "test:types": "phpstan",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Milzer\\SaloonLogger\\Laravel\\SaloonLoggerServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
